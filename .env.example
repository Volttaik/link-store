# ============================================================================
# Rush Cart — environment template.  Copy to `.env.local` and fill in.
# ============================================================================

# --- Database (Turso / libSQL) ----------------------------------------------
# Leave unset in development to use a local libSQL file database at
# ./data/linkstore.db (real SQLite, real SQL — just not remotely hosted).
# In production point these at your Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Sessions ---------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Authentication ---------------------------------------------------------
# Signs every session cookie and token. Required in production; generate with
# `openssl rand -base64 48`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=

# --- Google sign-in (optional) ----------------------------------------------
# Create an OAuth 2.0 Client ID in Google Cloud Console (type: Web application)
# and register these Authorised redirect URIs — the path is fixed by the
# authentication engine and must match exactly:
#   Development:   http://localhost:5000/api/auth/callback/google
#   Production:    https://your-domain.com/api/auth/callback/google
# Leave both unset and the Google button simply does not appear; email codes
# still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (object storage) -----------------------------------------
# When these are absent the app falls back to a local disk storage driver so
# uploads still work in development. In production they are required.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Keep your existing bucket name; rebranding must not move uploaded files.
# Public base URL for the bucket (r2.dev domain or a custom domain).
R2_PUBLIC_BASE_URL=

# --- Paystack (payments) ----------------------------------------------------
# Without these, checkout explains that payments are not configured instead of
# faking a successful payment.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Resend (transactional email) -------------------------------------------
# Without an API key, orders still fulfil and receipts are still recorded — the
# UI reports that the email could not be sent rather than pretending it went.
# Sent through Resend's HTTP API directly (a plain POST), so there is no SDK to
# install.
RESEND_API_KEY=
# The authenticated sender for all transactional email. Must be an address on a
# domain verified in Resend, otherwise only the account owner can receive mail.
# Include the display name for a nicer inbox line.
RESEND_FROM_EMAIL="Rush Cart <invoices@example.com>"
# Optional monitored support mailbox; must be a valid address.
RESEND_REPLY_TO_EMAIL=
# Sending is blocked unless the app URL is public HTTPS (not a preview host).
# Use your existing authenticated sender domain; see email-inventory.md.

# --- Browser Web Push ------------------------------------------------------
# Generate a stable key pair with: npx web-push generate-vapid-keys
# Keep the private key server-only. Requires HTTPS and db/schema.sql migration.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.com

# --- Platform ---------------------------------------------------------------
# Base URL used for Paystack callbacks and webhook-independent verification.
NEXT_PUBLIC_APP_URL=http://localhost:5000
# Commission charged on each sale, in percent (e.g. 2.5).
PLATFORM_FEE_PERCENT=2.5
